rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Bookings
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to create bookings
      allow update, delete: if request.auth != null;
    }
    
    // Package bookings
    match /package_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to create package bookings
      allow update, delete: if request.auth != null;
    }
    
    // Contact messages
    match /contact_messages/{messageId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true; // Allow anyone to submit a contact form
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agents
    match /agents/{agentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // E-service requests
    match /eservice_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to submit an e-service application
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // E-service fee settings
    match /eservice_fee_settings/{serviceType} {
      allow read: if true; // Allow anyone to read the fee settings
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Visa services
    match /visa-services/{applicationId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to submit a visa application
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Hotel bookings
    match /hotel_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to book hotels
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Packages
    match /packages/{packageId} {
      allow read: if true; // Allow anyone to view packages
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Coupons
    match /coupons/{couponId} {
      allow read: if true; // Allow anyone to read coupons
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Visitor analytics
    match /visitor_sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true;
      allow update: if resource.data.sessionId == request.resource.data.sessionId;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Visitor analytics data
    match /visitor_analytics/{analyticsId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Button click tracking for visitor analytics
    match /button_clicks/{clickId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to record button clicks
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
  }
}