rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bookings - allow anyone to create
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to create bookings
      allow update, delete: if request.auth != null;
    }
    
    // Package bookings
    match /package_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to create package bookings
      allow update, delete: if request.auth != null;
    }
    
    // Contact messages (legacy collection name)
    match /contact_messages/{messageId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true; // Allow anyone to submit a contact form
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Contact submissions (active collection used by contact form)
    match /contact_submissions/{messageId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to submit a contact form
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agents
    match /agents/{agentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // E-service requests
    match /eservice_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to submit an e-service application
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // E-service fee settings
    match /eservice_fee_settings/{serviceType} {
      allow read: if true; // Allow anyone to read the fee settings
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Visa services
    match /visa-services/{applicationId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to submit a visa application
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Hotel bookings
    match /hotel_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to book hotels
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Packages
    match /packages/{packageId} {
      allow read: if true; // Allow anyone to view packages
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Coupons - allow anyone to read and update usage (for tracking)
    match /coupons/{couponId} {
      allow read: if true; // Allow anyone to read coupons
      allow create: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow update: if true; // Allow coupon usage updates from anyone
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Visitor analytics
    match /visitor_sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true;
      allow update: if true; // Allow session updates
      allow delete: if true; // Allow session cleanup on page unload
    }
    
    // Visitor analytics data
    match /visitor_analytics/{analyticsId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Button click tracking for visitor analytics
    match /button_clicks/{clickId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to record button clicks
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // FCM push notification tokens
    match /fcm_tokens/{tokenId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null; // Authenticated admin/agents can save their tokens
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Admin settings (UPI settings, notification settings, etc.)
    match /admin_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Bills / Invoices
    match /bills/{billId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agent booking credentials (booking platform IDs/passwords)
    match /agent_booking_credentials/{credentialId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Agent tasks
    match /agent_tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Task completion history
    match /task_completion_history/{historyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agent wallets
    match /agent_wallets/{walletId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agent daily wallet entries
    match /agent_daily_wallet/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        request.auth.token.email == 'admin@anandtravels.com' ||
        resource.data.agentEmail == request.auth.token.email
      );
    }
    
    // Agent wallet summary (aggregates)
    match /agent_wallet_summary/{agentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agent booking rotation state
    match /agent_booking_rotation/{agentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Agent earnings tracking
    match /agent_earnings/{agentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Team members (public-facing)
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Company documents (public-facing)
    match /company_documents/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Collaborations (public-facing)
    match /collaborations/{collabId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Hotels
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Room types
    match /room_types/{roomTypeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Hotel agents
    match /hotel_agents/{agentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Career jobs (public-facing)
    match /career_jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Career applications
    match /career_applications/{applicationId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // WhatsApp conversations (admin only)
    match /whatsapp_conversations/{convoId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // WhatsApp messages (admin only)
    match /whatsapp_messages/{msgId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@anandtravels.com';
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}