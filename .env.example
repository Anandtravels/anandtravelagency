# Google Gemini API Keys for AI Chatbot (Multiple keys for fallback)
# Get your API keys from: https://makersuite.google.com/app/apikey
# The chatbot will automatically try the next key if one fails
VITE_GEMINI_API_KEY_1=your_first_gemini_api_key_here
VITE_GEMINI_API_KEY_2=your_second_gemini_api_key_here
VITE_GEMINI_API_KEY_3=your_third_gemini_api_key_here
VITE_GEMINI_API_KEY_4=your_fourth_gemini_api_key_here
VITE_GEMINI_API_KEY_5=your_fifth_gemini_api_key_here
VITE_GEMINI_API_KEY_6=your_sixth_gemini_api_key_here

# Firebase Cloud Messaging - Web Push Certificate (VAPID Key)
# Get from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here

# Gemini Model Version
# Options: gemini-2.5-flash, gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
# Default: gemini-2.5-flash (fastest, most advanced flash model)
VITE_GEMINI_MODEL=gemini-2.5-flash

# Cloudinary Configuration for QR Code Image Hosting
# Get credentials from: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=qr_codes_unsigned
