# Google Gemini API Key for AI Chatbot
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Version
# Options: gemini-2.0-flash-exp, gemini-2.0-pro-exp, gemini-1.5-pro, gemini-1.5-flash
# Default: gemini-2.0-flash-exp (fastest, most advanced flash model)
# Recommended: gemini-2.0-flash-exp for production (best balance of speed and quality)
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# Cloudinary Configuration for QR Code Image Hosting
# Get credentials from: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=qr_codes_unsigned
